{
  "name": "critbit",
  "version": "1.0.0",
  "description": "Crit-bit trees for JavaScript: sorted sets and maps of strings with fast prefix queries.",
  "license": "BSD-3-Clause",
  "keywords": [
    "critbit",
    "crit-bit tree",
    "patricia trie",
    "radix tree",
    "trie",
    "sorted set",
    "sorted map",
    "prefix search"
  ],
  "homepage": "https://github.com/jasondavies/critbit.js",
  "author": {
    "name": "Jason Davies",
    "url": "https://www.jasondavies.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasondavies/critbit.js.git"
  },
  "type": "module",
  "main": "critbit.js",
  "types": "critbit.d.ts",
  "exports": {
    ".": {
      "types": "./critbit.d.ts",
      "default": "./critbit.js"
    }
  },
  "sideEffects": false,
  "files": [
    "critbit.js",
    "critbit.d.ts"
  ],
  "scripts": {
    "test": "node --test test/critbit-test.js",
    "bench": "node --expose-gc test/bench.js"
  },
  "engines": {
    "node": ">=22"
  }
}
